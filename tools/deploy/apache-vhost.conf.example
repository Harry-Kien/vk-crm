# VK-CRM — mẫu VirtualHost Apache cho máy chủ thật (SPEC §10 mục 1, kế hoạch M8 Task 1).
#
# ĐÂY LÀ MẪU — sửa domain, đường dẫn chứng chỉ TLS và đường dẫn dự án (/var/www/vk-crm) cho đúng
# máy chủ thật. Cần `mod_ssl`, `mod_rewrite`, `mod_headers` (`a2enmod ssl rewrite headers`). Đã
# CHẠY THỬ bằng `httpd -t` trong container `httpd:2.4-alpine` chính thức ngày 2026-09-28 (kết quả
# ở `docs/PROGRESS.md`, mục "Ghi chú M8"). Cùng ba lớp và cùng lý do với
# `tools/deploy/nginx.conf.example` — đọc docblock ở đó trước, không lặp lại ở đây.

<VirtualHost *:80>
    ServerName khachhang.luatvukhang.com
    DocumentRoot /var/www/vk-crm/public

    # Cho phép ACME http-01 (Let's Encrypt / Certbot) xin chứng chỉ mà không bị chuyển hướng.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName khachhang.luatvukhang.com
    DocumentRoot /var/www/vk-crm/public

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/khachhang.luatvukhang.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/khachhang.luatvukhang.com/privkey.pem
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    # SPEC §10 mục 1 — chỉ có nghĩa trên response ĐÃ qua https, nên chỉ đặt ở VirtualHost 443.
    # KHÔNG includeSubDomains/preload — cùng lý do và cùng phán quyết với bản nginx.
    Header always set Strict-Transport-Security "max-age=31536000"

    # SPEC §10 mục 8 — kích thước tối đa MỘT request (byte). 25 MB cho UPLOAD_MAX_MB=20 mặc định
    # (.env) — ĐỔI nếu UPLOAD_MAX_MB khác 20.
    LimitRequestBody 26214400

    <Directory /var/www/vk-crm/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Chặn dotfile (.env, .git, .htaccess nguồn…) — không route nào của Laravel có tiền tố dấu
    # chấm.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Dự án KHÔNG dùng `storage:link` (SPEC §2) — không có `public/storage` hợp lệ nào trỏ vào
    # `storage/app/private`. Chặn ở tầng máy chủ web làm lớp phòng thủ thứ hai, cùng cách nginx.
    <LocationMatch "^/storage/">
        Require all denied
    </LocationMatch>

    # Ba header SPEC §10 mục 2 cho tệp tĩnh — PHP không chạm tới các request này.
    <FilesMatch "\.(?:css|js|mjs|map|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)$">
        Header always set X-Frame-Options "DENY"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</VirtualHost>
