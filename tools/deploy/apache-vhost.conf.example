# VK-CRM — mẫu VirtualHost Apache cho máy chủ thật (SPEC §10 mục 1, kế hoạch M8 Task 1).
#
# ĐÂY LÀ MẪU — sửa domain, đường dẫn chứng chỉ TLS và đường dẫn dự án (/var/www/vk-crm) cho đúng
# máy chủ thật. Cần `mod_ssl`, `mod_rewrite`, `mod_headers`, `mod_alias`
# (`a2enmod ssl rewrite headers alias`). Đã CHẠY THỬ bằng `httpd -t` trong container
# `httpd:2.4-alpine` chính thức ngày 2026-09-28 (kết quả ở `docs/PROGRESS.md`, mục "Ghi chú M8"),
# và phần chặn `/storage/` + dotfile chạy THẬT với request thật ngày 2026-10-01
# (`tools/deploy/verify-storage-blocked.sh`, M8 Task 4). Cùng ba lớp và cùng lý do với
# `tools/deploy/nginx.conf.example` — đọc docblock ở đó trước, không lặp lại ở đây.

<VirtualHost *:80>
    ServerName khachhang.luatvukhang.com
    DocumentRoot /var/www/vk-crm/public

    # Cho phép ACME http-01 (Let's Encrypt / Certbot) xin chứng chỉ mà không bị chuyển hướng.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName khachhang.luatvukhang.com
    DocumentRoot /var/www/vk-crm/public

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/khachhang.luatvukhang.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/khachhang.luatvukhang.com/privkey.pem
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    # SPEC §10 mục 1 — chỉ có nghĩa trên response ĐÃ qua https, nên chỉ đặt ở VirtualHost 443.
    # KHÔNG includeSubDomains/preload — cùng lý do và cùng phán quyết với bản nginx.
    Header always set Strict-Transport-Security "max-age=31536000"

    # SPEC §10 mục 8 — kích thước tối đa MỘT request (byte). 25 MB cho UPLOAD_MAX_MB=20 mặc định
    # (.env) — ĐỔI nếu UPLOAD_MAX_MB khác 20.
    LimitRequestBody 26214400

    # Apache ở đây là máy chủ web DUY NHẤT đứng trước PHP (mod_php hoặc php-fpm qua mod_proxy_fcgi
    # cùng máy) — không phải một reverse-proxy tách rời mà Laravel cần "tin" theo nghĩa
    # `TRUSTED_PROXIES` (SPEC §10.3, `config/trustedproxy.php`); `REMOTE_ADDR` mà PHP thấy đã là
    # địa chỉ thật của client. `.env` điền `TRUSTED_PROXIES=127.0.0.1` — KHÔNG dùng
    # `*`/`**`/`0.0.0.0/0`/`::/0`: bốn giá trị đó tin bất kỳ ai tự khai `X-Forwarded-For`, xuyên
    # thủng `ADMIN_IP_ALLOWLIST` (R7) và bộ đếm đăng nhập theo IP — `vkcrm:preflight` (R1) chặn đỏ
    # cả bốn. Có CDN/reverse-proxy thật đứng trước tầng Apache này thì điền địa chỉ/dải IP THẬT.

    <Directory /var/www/vk-crm/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Chặn dotfile VÀ thư mục dấu chấm (.env, .git, .github/…, .htaccess…) — không route nào của
    # Laravel có một đoạn đường dẫn bắt đầu bằng dấu chấm. `RedirectMatch` (mod_alias, chạy ở pha
    # dịch URL, trước mọi kiểm tra quyền và trước `.htaccess`) so trên CẢ đường dẫn URL; bản
    # `<FilesMatch "^\.">` trước M8 Task 4 chỉ so TÊN TỆP cuối, nên khi `DocumentRoot` đặt nhầm vào
    # gốc dự án nó vẫn phát `/.github/workflows/<tệp>` — đo được, xem
    # `tools/deploy/verify-storage-blocked.sh`. 404, cùng mã với bản nginx.
    RedirectMatch 404 "/\."

    # SPEC §10.4 — `/storage/` KHÔNG BAO GIỜ do máy chủ web phục vụ, và trả 404 như bản nginx (đọc
    # docblock khối `location ^~ /storage/` ở đó: hai cấu hình sai mà khối này chặn). Dự án KHÔNG
    # dùng `storage:link` (SPEC §2). `storage/app/private/.htaccess` (`Require all denied`, 403) là
    # lớp thứ ba, chỉ có tác dụng khi `AllowOverride` cho phép. Cả ba lớp đã CHẠY THẬT trong
    # container `httpd:2.4-alpine` chính thức: `tools/deploy/verify-storage-blocked.sh`.
    RedirectMatch 404 "^/storage/"

    # Ba header SPEC §10 mục 2 cho tệp tĩnh — PHP không chạm tới các request này.
    <FilesMatch "\.(?:css|js|mjs|map|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)$">
        Header always set X-Frame-Options "DENY"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</VirtualHost>
