APP_NAME="VK-CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Cơ sở dữ liệu (Sail: host mariadb; shared hosting/VPS: 127.0.0.1) ---
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=vk_crm
DB_USERNAME=sail
DB_PASSWORD=password

# --- Bắt buộc dùng database cho session/queue/cache (không Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email qua SMTP tên miền riêng (local: Mailpit) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Tên người gửi: tên văn phòng khách nhận ra trong hộp thư, KHÔNG phải APP_NAME (tên kỹ thuật —
# xem M6.5 Task 12, notify-14). Đổi cùng lúc với config('vkcrm.brand.short_name') nếu tên đổi.
MAIL_FROM_ADDRESS="no-reply@luatvukhang.com"
MAIL_FROM_NAME="Luật Vũ Khang"

# --- VK-CRM ---
# Để trống cả hai => /admin và /portal chạy chung APP_URL. Điền để tách subdomain.
ADMIN_DOMAIN=
PORTAL_DOMAIN=
MATTER_CODE_PREFIX=VK
UPLOAD_MAX_MB=20
RETENTION_YEARS=10
CLIENT_ACCESS_DAYS=90
# URL ping của dịch vụ giám sát cron (ví dụ healthchecks.io). Để trống để tắt.
HEARTBEAT_URL=
# Địa chỉ THẬT của proxy/CDN đứng trước ứng dụng, ngăn cách bằng dấu phẩy. Để KHÔNG KHAI DÒNG NÀY
# là không tin ai — đúng cho máy dev. Trên máy thật mà để trống thì mọi khách dùng chung một địa
# chỉ IP: một người gõ sai 5 lần khoá cả cổng 15 phút (SPEC §10.3), và last_login_ip /
# stage_log_views.ip ghi lại địa chỉ của proxy chứ không phải của khách. Mục chặn ra mắt:
# docs/PROGRESS.md, "CHẶN RA MẮT — TRUSTED_PROXIES phải được điền trước khi cổng đứng trước mặt
# khách". Dùng đúng mẫu tools/deploy/ (nginx/apache nói thẳng với php-fpm, không proxy tách rời)?
# Điền TRUSTED_PROXIES=127.0.0.1 — không có proxy để tin, REMOTE_ADDR đã là địa chỉ thật.
# KHÔNG dùng `*`: nó tin bất kỳ IP nào tự khai X-Forwarded-For, xuyên thủng ADMIN_IP_ALLOWLIST
# (R7) và bộ đếm đăng nhập theo IP — vkcrm:preflight chặn đỏ `*`/`**`/0.0.0.0/0/::/0.
# TRUSTED_PROXIES=
CLAMAV_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# Hạn cho mỗi lần đọc/ghi socket sau khi đã kết nối (giây) — xem config/vkcrm.php
CLAMAV_TIMEOUT=30

# --- Sail (chỉ dùng local) ---
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"

# --- Sao lưu (spatie/laravel-backup, SPEC §10 mục 8, R3, M8a Task 1) ---
# BACKUP_DISKS THAY THẾ biến BACKUP_DISK (số ít) cũ — biến đó không còn được đọc ở đâu, dòng mẫu
# của nó đã xoá ở M8 Task 7 (xem docs/research/2026-09-26-sao-luu.md). Danh sách disk
# Filesystem, phân tách dấu phẩy, ví dụ: BACKUP_DISKS=google,office (hai disk đó thêm ở Task 2/3
# của kế hoạch M8a). Để trống dùng disk local mặc định (storage/app/backups).
BACKUP_DISKS=
# Tên thư mục chứa bản sao lưu trên mỗi disk đích, và (dạng slug) tiền tố tên archive — do người
# vận hành tự đặt, ví dụ "VK-CRM production" khi nhiều môi trường dùng chung một Google Drive.
# Để trống dùng APP_NAME.
BACKUP_NAME=
# Mật khẩu mã hoá archive (AES-256), do người vận hành tự tạo (chuỗi ngẫu nhiên dài). BẮT BUỘC
# khi APP_ENV=production: thiếu nó, HOẶC máy chủ không mã hoá được AES-256 (libzip cũ), lượt sao
# lưu thất bại — không tạo archive, có thư báo lỗi. Cất một bản RIÊNG cùng chỗ với APP_KEY thật,
# ở HAI nơi ngoài máy chủ, KHÔNG cùng chỗ với bản sao lưu (R3; docs/SAO-LUU-KHOI-PHUC.md Bước 6).
BACKUP_ARCHIVE_PASSWORD=
# Người nhận thư báo lỗi sao lưu/dọn dẹp/bản sao không lành mạnh — một địa chỉ, hoặc nhiều địa
# chỉ phân tách dấu phẩy (ví dụ ops@vidu.vn,ke-toan@vidu.vn). Địa chỉ sai định dạng bị bỏ qua và
# ghi vào log, không làm hỏng lệnh nào. Để trống thì gửi cho mọi nhân sự đang hoạt động
# (is_active=true) mang vai trò Admin.
BACKUP_NOTIFY_EMAIL=
# --- Đẩy sao lưu ra Google Drive bằng rclone (M8a Task 2 — dùng rclone thay adapter Flysystem,
# xem docs/research/2026-09-26-sao-luu.md mục "Task 2") ---
# Remote rclone đích, do người vận hành tạo bằng `rclone config` trên máy chủ (xem
# docs/SAO-LUU-KHOI-PHUC.md), ví dụ: gdrive:VK-CRM-backups. Để trống thì TẮT HẲN việc đẩy ra Google
# Drive — chỉ còn các disk khai ở BACKUP_DISKS phía trên (ở production, mỗi đêm có thư báo lỗi
# "không có bản sao ngoài máy chủ" cho tới khi bật một đích ngoài máy chủ). Archive đi vào thư mục
# con riêng của môi trường, đặt theo BACKUP_NAME (ví dụ gdrive:VK-CRM-backups/vk-crm-production) —
# nhiều môi trường dùng chung một remote thì mỗi môi trường PHẢI có BACKUP_NAME khác nhau.
# ⚠ Khi biến này CÓ giá trị, BACKUP_DISKS ở trên PHẢI còn "local_backups" — lượt đẩy đi qua đúng
# đĩa đó. Bỏ "local_backups" ra khỏi BACKUP_DISKS trong khi biến này vẫn có giá trị làm việc đẩy
# lên Google Drive lặng lẽ không chạy nữa (vkcrm:backup-check và backup:run đều tự báo lỗi này).
BACKUP_RCLONE_REMOTE=
# Đường dẫn binary rclone trên máy chủ, do người vận hành cài đặt (xem docs/SAO-LUU-KHOI-PHUC.md).
# Để trống dùng "rclone" (tìm trong PATH của hệ thống).
BACKUP_RCLONE_BINARY=
# Đường dẫn tệp rclone.conf, CHỈ cần khi không dùng nơi dò tìm mặc định của rclone hay biến
# RCLONE_CONFIG_*. Tệp này do `rclone config` tạo ra trên máy chủ — không commit vào repo. Để
# trống để rclone tự dò.
BACKUP_RCLONE_CONFIG=
# Số bản sao lưu giữ lại TRÊN MÁY CHỦ (disk local_backups) khi BACKUP_RCLONE_REMOTE đã bật — Google
# Drive giữ đủ 30 bản (SPEC §10 mục 8), máy chủ chỉ cần vài bản gần nhất để khôi phục nhanh, tránh
# đầy ổ đĩa VPS. Để trống dùng 7.
BACKUP_LOCAL_KEEP=
# --- Content-Security-Policy (SPEC §10 mục 2, phán quyết R4 — docs/research/2026-09-26-csp-khao-sat.md) ---
# off | report | enforce, do người vận hành chọn. Để trống: report CHỈ khi APP_ENV là local hoặc
# testing (trình duyệt chỉ báo vi phạm ra console, không chặn); mọi APP_ENV khác — production,
# staging, kể cả gõ sai — là enforce. Muốn nới thì phải viết ra report hoặc off. Giá trị CSP_MODE
# gõ sai cũng được coi là enforce. Ba header X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy luôn bật, kể cả khi off.
CSP_MODE=
# --- Sao lưu: thêm (lượt rà soát cuối M8a) ---
# Hạn cho MỖI lệnh rclone, tính bằng giây — người vận hành nới ra khi archive rất lớn hoặc đường
# truyền lên Google Drive chậm (lệnh chạy quá hạn bị coi là thất bại, có thư báo lỗi). Để trống
# dùng 1800 (30 phút).
BACKUP_RCLONE_TIMEOUT=
# Hạn mức dung lượng MỖI đĩa sao lưu, tính bằng MB — backup:monitor (08:00) gửi thư "bản sao lưu
# không lành mạnh" khi một đĩa vượt mức. Người vận hành chọn theo dung lượng ổ đĩa máy chủ. Để
# trống dùng 25000 (~24 GB — đủ 7 bản của một archive 3 GB).
BACKUP_MAX_STORAGE_MB=
# --- Ép HTTPS, HSTS, giới hạn IP admin (SPEC §10 mục 1; R1, R7 — kế hoạch M8 Task 1) ---
# Cookie phiên chỉ gửi qua kết nối https. Để trống: true ở mọi môi trường trừ local/testing (máy
# chủ thật PHẢI true — vkcrm:preflight báo ĐỎ nếu giải ra khác true ở production). Chỉ để false
# tường minh ở một máy dev/staging cố tình chạy http.
SESSION_SECURE_COOKIE=
# Ép mọi request http chuyển hướng sang https (301 với GET/HEAD, 308 với phương thức khác — không
# mất thân request). Để trống: true ở mọi môi trường trừ local/testing — docs/CAI-DAT.md dùng
# chính .env.example này cho máy dev chạy http nên KHÔNG đặt cứng true ở đây. Một staging cố tình
# chạy http phải ghi rõ FORCE_HTTPS=false.
FORCE_HTTPS=
# HSTS (Strict-Transport-Security), max-age tính bằng giây — lớp CHÍNH là cấu hình máy chủ web
# (tools/deploy/nginx.conf.example, tools/deploy/apache-vhost.conf.example); biến này chỉ là lớp
# DỰ PHÒNG ở tầng app khi hosting không cho tự cấu hình máy chủ web. Để trống: 31536000 (một năm)
# ở mọi môi trường trừ local/testing (0 — tắt, vì bật HSTS trên máy dev chạy http tự khoá trình
# duyệt của người dev vào https một thời gian dài).
HSTS_MAX_AGE=
# includeSubDomains/preload của HSTS — KHÔNG bật trừ khi ghi rõ true, BẤT KỂ môi trường: website
# luatvukhang.com và các tên miền con khác của văn phòng nằm NGOÀI ứng dụng này, bật nhầm khoá
# luôn chúng vào https một năm.
HSTS_INCLUDE_SUBDOMAINS=
HSTS_PRELOAD=
# Danh sách IP/CIDR được vào /admin, phân tách dấu phẩy (ví dụ 203.0.113.10,10.0.0.0/24) — do
# người vận hành/chủ văn phòng chọn (hỏi trước khi bật, xem docs/PROGRESS.md mục "Ghi chú M8"). Để
# trống = TẮT HẲN, đây là mặc định. KHÔNG phủ đường tải tệp có chữ ký (documents.download).
ADMIN_IP_ALLOWLIST=
# --- Thương hiệu và thông tin pháp lý của văn phòng (config/vkcrm.php, khoá brand; M8 Task 7) ---
# Bốn thông tin pháp lý in ở chân MỌI thư gửi khách (App\Support\BrandFooter) — luật và thông lệ
# đòi chân thư của một tổ chức hành nghề luật nêu đủ chúng. Website luatvukhang.com KHÔNG đăng
# chúng, nên giá trị thật CHỈ chủ văn phòng cung cấp (giấy tờ đăng ký của công ty) — bỏ dấu # và
# điền, không đoán. Còn dấu # (chưa điền) thì dòng đó không in ra (không phải một chỗ "Mã số
# thuế:" bỏ ngỏ) và vkcrm:preflight báo VÀNG. Để dạng chú thích chứ không phải `BIẾN=` rỗng vì CI
# chạy `cp .env.example .env`: một dòng rỗng là một biến TỒN TẠI với chuỗi rỗng, khác "không khai
# báo" (bài học e2e/F1, TRUSTED_PROXIES; M6 Task 10). Từ khi M7 Task 10 được gộp, chủ văn phòng sửa
# bốn thông tin này ngay trong ứng dụng.
# Mã số thuế của công ty luật, ví dụ 0101234567.
# BRAND_TAX_CODE=
# Đoàn Luật sư mà công ty là thành viên, ví dụ "Đoàn Luật sư TP. Hồ Chí Minh".
# BRAND_BAR_ASSOCIATION=
# Số Giấy đăng ký hoạt động do Sở Tư pháp cấp, đúng như in trên giấy.
# BRAND_LICENCE_NUMBER=
# Địa chỉ trụ sở đầy đủ, in nguyên văn ở chân thư.
# BRAND_OFFICE_ADDRESS=
# Các biến dưới đây ĐÃ CÓ giá trị mặc định đúng của Vũ Khang trong config/vkcrm.php (giá trị ghi
# sau dấu = ở từng dòng). Để nguyên dấu # là dùng mặc định. Chỉ bỏ dấu # và sửa khi văn phòng
# đổi. ĐỪNG để một dòng BRAND_…= trống: dòng trống là CHUỖI RỖNG, không phải "dùng mặc định" —
# tên văn phòng biến mất khỏi trang đăng nhập, thư và chân thư.
# Tên pháp lý đầy đủ — trang đăng nhập, ký tên cuối thư.
# BRAND_LEGAL_NAME="Công ty Luật TNHH Vũ Khang Solutions & Partners"
# Tên ngắn — mục "2FA" trong app xác thực của nhân sự, nơi cần tên gọn.
# BRAND_SHORT_NAME="Luật Vũ Khang"
# Tên pháp lý tách ba dòng cho khối chữ cạnh logo: loại hình / tên / hậu tố.
# BRAND_LOCKUP_ENTITY="Công ty Luật TNHH"
# BRAND_LOCKUP_NAME="Vũ Khang"
# BRAND_LOCKUP_SUFFIX="Solutions & Partners"
# Khẩu hiệu dưới logo ở trang đăng nhập — lấy từ website của văn phòng.
# BRAND_TAGLINE="Thấu hiểu vấn đề. Vững vàng quyết định."
# Website, hotline và đường Zalo in ở trang đăng nhập, trang lỗi, thư gửi khách.
# BRAND_WEBSITE=https://luatvukhang.com
# BRAND_HOTLINE=0832270898
# BRAND_ZALO=https://zalo.me/0832270898
# Hộp thư CÓ NGƯỜI ĐỌC nhận thư khi khách bấm "Trả lời" (Reply-To của mọi thư) — chủ văn phòng xác
# nhận địa chỉ. Ba trường hợp (docs/CAI-DAT.md, Bước 3): còn dấu # = mặc định lienhe@luatvukhang.com;
# bỏ dấu # và để trống sau dấu = thì thư KHÔNG có Reply-To, khách trả lời rơi vào hộp no-reply@;
# điền một địa chỉ = dùng địa chỉ đó.
# BRAND_REPLY_TO_ADDRESS=lienhe@luatvukhang.com
# Phông chữ của hai panel (tải từ fonts.bunny.net — CSP đã cho phép tên miền đó).
# BRAND_FONT="Be Vietnam Pro"
# --- Máy chủ MCP cho nhân sự (kế hoạch M11; config/vkcrm.php khoá mcp, config/passport.php) ---
# Origin thêm được gọi /mcp từ trình duyệt, ngoài https://claude.ai, https://chatgpt.com và origin
# của APP_URL (đã có sẵn). Dạng scheme://host[:port], phân tách dấu phẩy, so khớp chính xác, không
# nhận ký tự đại diện. Client gọi từ máy chủ (Claude, ChatGPT) không gửi Origin nên không cần ở đây.
MCP_EXTRA_ALLOWED_ORIGINS=
# Khoá ký token OAuth của Passport. Mặc định đọc TỆP storage/oauth-private.key và
# storage/oauth-public.key, sinh bằng `php artisan passport:keys` lúc cài đặt (quyền tệp 600/660).
# Chỉ bỏ dấu # khi máy chủ không giữ được tệp: dán NỘI DUNG khoá PEM, xuống dòng viết là \n.
# Mất hoặc đổi khoá riêng thì mọi kết nối AI của mọi nhân sự phải đăng nhập lại.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
