APP_NAME="VK-CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Cơ sở dữ liệu (Sail: host mariadb; shared hosting/VPS: 127.0.0.1) ---
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=vk_crm
DB_USERNAME=sail
DB_PASSWORD=password

# --- Bắt buộc dùng database cho session/queue/cache (không Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email qua SMTP tên miền riêng (local: Mailpit) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Tên người gửi: tên văn phòng khách nhận ra trong hộp thư, KHÔNG phải APP_NAME (tên kỹ thuật —
# xem M6.5 Task 12, notify-14). Đổi cùng lúc với config('vkcrm.brand.short_name') nếu tên đổi.
MAIL_FROM_ADDRESS="no-reply@luatvukhang.com"
MAIL_FROM_NAME="Luật Vũ Khang"

# --- VK-CRM ---
# Để trống cả hai => /admin và /portal chạy chung APP_URL. Điền để tách subdomain.
ADMIN_DOMAIN=
PORTAL_DOMAIN=
MATTER_CODE_PREFIX=VK
UPLOAD_MAX_MB=20
RETENTION_YEARS=10
CLIENT_ACCESS_DAYS=90
# URL ping của dịch vụ giám sát cron (ví dụ healthchecks.io). Để trống để tắt.
HEARTBEAT_URL=
# Địa chỉ THẬT của proxy/CDN đứng trước ứng dụng, ngăn cách bằng dấu phẩy (hoặc `*` nếu không
# biết được). Để KHÔNG KHAI DÒNG NÀY là không tin ai — đúng cho máy dev. Trên máy thật mà để
# trống thì mọi khách dùng chung một địa chỉ IP: một người gõ sai 5 lần khoá cả cổng 15 phút
# (SPEC §10.3), và last_login_ip / stage_log_views.ip ghi lại địa chỉ của proxy chứ không phải
# của khách. Mục chặn ra mắt: docs/PROGRESS.md, "CHẶN RA MẮT — TRUSTED_PROXIES phải được điền
# trước khi cổng đứng trước mặt khách".
# TRUSTED_PROXIES=
CLAMAV_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# Hạn cho mỗi lần đọc/ghi socket sau khi đã kết nối (giây) — xem config/vkcrm.php
CLAMAV_TIMEOUT=30

# --- Sao lưu ngoài máy chủ (S3-compatible: Cloudflare R2 / Backblaze B2 / AWS S3) ---
BACKUP_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Sail (chỉ dùng local) ---
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"

# --- Nhận diện thương hiệu trong thư và trên hai panel (config/vkcrm.php, mục `brand`) ---
# M6 Task 10: mọi thư của M6 (BrandedMailable) đọc các biến dưới đây cho tiêu đề, chân thư và
# Reply-To. Giá trị dưới đây trùng mặc định trong config/vkcrm.php. Muốn dùng mặc định thì XOÁ hẳn
# dòng đó — `BIẾN=` để trống là chuỗi rỗng, không phải mặc định. Điền giá trị thật lúc triển khai là
# việc của M8.
BRAND_LEGAL_NAME="Công ty Luật TNHH Vũ Khang Solutions & Partners"
BRAND_SHORT_NAME="Luật Vũ Khang"
BRAND_LOCKUP_ENTITY="Công ty Luật TNHH"
BRAND_LOCKUP_NAME="Vũ Khang"
BRAND_LOCKUP_SUFFIX="Solutions & Partners"
BRAND_TAGLINE="Thấu hiểu vấn đề. Vững vàng quyết định."
BRAND_WEBSITE=https://luatvukhang.com
BRAND_HOTLINE=0832270898
BRAND_ZALO=https://zalo.me/0832270898
BRAND_FONT="Be Vietnam Pro"
# Hộp thư THẬT có người đọc, gắn làm Reply-To cho MỌI thư (khác MAIL_FROM_ADDRESS no-reply chỉ để
# SPF/DKIM): khách hay nhân sự bấm "Trả lời" thì thư tới đây.
BRAND_REPLY_TO_ADDRESS=lienhe@luatvukhang.com
# Bốn thông tin chân thư mà một tổ chức hành nghề luật PHẢI nêu trước khi gửi thư cho khách hoặc
# xuất PDF. Website không đăng, nên để trống có chủ đích — chủ văn phòng bỏ dấu # và điền, không
# đoán. Để dạng chú thích (không phải `BIẾN=` rỗng) vì CI chạy `cp .env.example .env`: một dòng
# rỗng là một biến TỒN TẠI với chuỗi rỗng, khác "không khai báo" (bài học e2e/F1, TRUSTED_PROXIES).
# BRAND_TAX_CODE=
# BRAND_BAR_ASSOCIATION=
# BRAND_LICENCE_NUMBER=
# BRAND_OFFICE_ADDRESS=
