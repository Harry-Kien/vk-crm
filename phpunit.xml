<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- M14 Task 8: image Docker của máy dev mặc định memory_limit 512M. Bộ test (khoảng 6.900 test
             sau khi gộp M12 và M14) để lại bộ nhớ dần trong mỗi tiến trình của lượt chạy song song, và
             các ca khối 8 MiB của tests/Unit/Support/Storage/GoogleDrive/DriveUploadTest.php (gần cuối
             thứ tự tệp) chạm trần: WorkerCrashedException. CI (setup-php) chạy với memory_limit -1,
             nên dòng này chỉ đưa máy dev lại gần CI. -->
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="vi"/>
        <env name="ADMIN_DOMAIN" value=""/>
        <env name="PORTAL_DOMAIN" value=""/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Vòng sửa 1 (M6.5 Task 12, notify-14): ghim ở đây, không phụ thuộc `.env` cục bộ
             (gitignored) — xem tests/Feature/Mail/SenderIdentityTest.php và docs/CAI-DAT.md. -->
        <env name="MAIL_FROM_NAME" value="Luật Vũ Khang"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- M14 (rà soát Task 1, m6): kho tài liệu ở chế độ cục bộ và không có khoá Google nào trong
             cấu hình mặc định của tiến trình test, kể cả khi `.env` cục bộ (gitignored) đặt khác.
             Test cần kho Drive tự đặt cấu hình trên máy chủ Drive giả (tests/Support/FakeGoogleDrive.php). -->
        <env name="DOCUMENT_STORAGE" value="local"/>
        <env name="GOOGLE_DRIVE_CREDENTIALS_PATH" value=""/>
        <env name="GOOGLE_DRIVE_SHARED_DRIVE_ID" value=""/>
        <env name="GOOGLE_DRIVE_ROOT_FOLDER_ID" value=""/>
        <env name="GOOGLE_DRIVE_ALLOWED_MEMBERS" value=""/>
        <!-- M12 Task 4 (R7): thông báo đẩy TẮT trong test trừ khi test tự đặt khoá
             (Tests\Support\WebPushTestKeys) — `artisan webpush:vapid` ghi khoá thật vào `.env`
             cục bộ (gitignored), và bộ test không được xanh/đỏ theo máy. -->
        <env name="VAPID_SUBJECT" value=""/>
        <env name="VAPID_PUBLIC_KEY" value=""/>
        <env name="VAPID_PRIVATE_KEY" value=""/>
    </php>
</phpunit>
